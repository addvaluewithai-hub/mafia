# Public Supabase client settings for the mafia project
EXPO_PUBLIC_SUPABASE_URL=https://bwxgzcppxdrfcaorobpm.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_76VPHfV-oe9rexR8B80Vkw_M0LhqckV

# Web URL after deployment, used for room share links
EXPO_PUBLIC_APP_URL=https://your-game.example.com

# Native builds need the deployed API base URL. On web, relative /api routes are used.
EXPO_PUBLIC_API_BASE_URL=https://your-game.example.com

# Server-only. Never prefix this with EXPO_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key

# Ordered fallback. Gemini models use structured output; Gemma models are validated after generation.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
